APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legacy Filament admin (/admin/* screens that v2 replaced).
# false = those pages redirect to the v2 dashboard instead of rendering.
# /admin/login is served by the same panel and keeps working either way.
LEGACY_ADMIN_ENABLED=false

# --- Tenant identity -------------------------------------------------------
# Everything that makes this install a specific clinic. A new clinic is a new
# .env + a new database, never a new git branch. See config/tenant.php.
TENANT_SLUG=clinic
TENANT_NAME_EN="Clinic"
TENANT_NAME_AR="عيادة"
TENANT_TAGLINE_EN=
TENANT_TAGLINE_AR=
TENANT_EMAIL=
TENANT_PHONE=
TENANT_WHATSAPP=
TENANT_WEBSITE=
TENANT_ADDRESS_EN=
TENANT_ADDRESS_AR=
TENANT_INSTAGRAM=
TENANT_TIKTOK=
TENANT_SNAPCHAT=

# First branch (further branches are added in the admin)
TENANT_BRANCH_SLUG=
TENANT_BRANCH_NAME_EN=
TENANT_BRANCH_NAME_AR=
TENANT_BRANCH_CITY=
TENANT_BRANCH_ADDRESS=
TENANT_MAX_BOOKING_DAYS=30
TENANT_DEFAULT_ROOM_NAME="Room 1"

# Starter staff accounts. No default password: seeding aborts without one.
TENANT_STAFF_EMAIL_DOMAIN=
TENANT_STAFF_PASSWORD=

# Branding. Source image for `php artisan brand:generate`; generated icons are
# gitignored so each deployment owns its own.
TENANT_BRAND_IMAGE=brand-source.jpg
TENANT_SHORT_NAME=
TENANT_PRIMARY_COLOR="#b19860"
TENANT_THEME_COLOR="#ffffff"

# --- Per-install integrations ----------------------------------------------
# Front-ends allowed to call this install cross-origin (comma-separated).
# Empty = same-origin only, which is right when there is no separate frontend.
CORS_ALLOWED_ORIGINS=

# Meta-registered WhatsApp template names are per-WABA. They share one prefix,
# so this renames the whole set. Must match what Meta has approved.
WHATSAPP_TEMPLATE_PREFIX=barfres
# Per-name overrides, for any template that doesn't follow the prefix.
WHATSAPP_TEMPLATE_INVITE=
WHATSAPP_TEMPLATE_CONFIRMED=
