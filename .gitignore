/vendor/
/node_modules/
/public/storage
/storage/*.key
/storage/app/*
!/storage/app/public
/storage/framework/*
!/storage/framework/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!.env.example
.env
.env.*
.phpunit.result.cache
Homestead.yaml
Homestead.json
npm-debug.log
yarn-error.log
.DS_Store
.idea
.vscode

# local DB backups
storage/backup_*.sql.gz

# compiled front-end assets (run `npm run build` on deploy)
/public/build

# Livewire's JS is normally served by a route, but nginx serves *.js straight
# from disk and 404s before reaching index.php. Copies of vendor/livewire/dist
# are staged here by the post-autoload-dump composer script instead.
/public/livewire

# Per-deployment branding, generated by `php artisan brand:generate` from
# TENANT_BRAND_IMAGE. Kept out of git so one repo can serve many clinics —
# each install owns its own icon set instead of needing its own branch.
/public/favicon.ico
/public/favicon.svg
/public/favicon-96x96.png
/public/apple-touch-icon.png
/public/web-app-manifest-*.png
/public/site.webmanifest
/public/logo.jpeg
/public/images/logo.*
/logo.svg

# Per-install source documents (supplier quotes, price lists) — business data,
# not code. Keep them on the server, out of the shared repo.
/*.xlsx
